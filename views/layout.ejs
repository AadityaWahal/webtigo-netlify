  <script>
    // Scroll Reveal Animation (Apple Style)
    document.addEventListener("DOMContentLoaded", function () {
      // 1. Enable JS animations only if JS loads
      document.body.classList.add('js-enabled');

      // 2. Fallback: If IntersectionObserver is not supported, reveal all immediately
      if (!('IntersectionObserver' in window)) {
        document.querySelectorAll('.tool-card').forEach(card => card.classList.add('reveal'));
        return;
      }

      const observerIn = new IntersectionObserver((entries) => {
        entries.forEach(entry => {
          if (entry.isIntersecting) {
            entry.target.classList.add('reveal');
            observerIn.unobserve(entry.target); // Performance: stop observing once revealed
          }
        });
      }, { threshold: 0.1, rootMargin: "50px" }); // Increased margin to trigger earlier

      const cards = document.querySelectorAll('.tool-card');
      cards.forEach((card, index) => {
        card.style.transitionDelay = `${index * 50}ms`; // Stagger effect
        observerIn.observe(card);
      });

      // Safety net: Force reveal immediately for crawlers
      setTimeout(() => {
        cards.forEach(card => card.classList.add('reveal'));
      }, 0);

      // User Profile Dropdown Toggle
      const userMenuBtn = document.getElementById('user-menu-btn');
      const userMenuDropdown = document.getElementById('user-menu-dropdown');
      if (userMenuBtn && userMenuDropdown) {
        userMenuBtn.addEventListener('click', (e) => {
          e.stopPropagation();
          const isVisible = userMenuDropdown.style.display === 'block';
          userMenuDropdown.style.display = isVisible ? 'none' : 'block';
        });
        document.addEventListener('click', () => {
          userMenuDropdown.style.display = 'none';
        });
      }

      // Initialize Clerk UI (if Clerk keys are provided)
      <% if (typeof clerkPublishableKey !== 'undefined' && clerkPublishableKey) { %>
      const initClerk = async () => {
        if (window.Clerk) {
          try {
            await window.Clerk.load();
            const userButtonEl = document.getElementById('user-button');
            const signInBtnEl = document.getElementById('sign-in-btn');

            if (window.Clerk.user) {
              if (userButtonEl) window.Clerk.mountUserButton(userButtonEl);
              if (signInBtnEl) signInBtnEl.style.display = 'none';
            } else {
              if (signInBtnEl) signInBtnEl.style.display = 'inline-flex';
            }
          } catch (error) {
            console.error('Error loading Clerk:', error);
          }
        }
      };

      if (window.Clerk) {
        initClerk();
      } else {
        const checkClerkInterval = setInterval(() => {
          if (window.Clerk) {
            clearInterval(checkClerkInterval);
            initClerk();
          }
        }, 100);
      }
      <% } %>
    });

    // Global Logout Handler (works with both built-in session and Clerk)
    window.handleLogout = async function() {
      try {
        if (window.Clerk && window.Clerk.signOut) {
          await window.Clerk.signOut();
        }
        await fetch('/api/auth/logout', { method: 'POST' });
      } catch (e) {
        console.error('Logout error:', e);
      }
      window.location.href = '/';
    };
  </script>

  <% if (typeof currentPath==='undefined' || (currentPath !=='/tts' && currentPath !=='/frequency' && currentPath
    !=='/frequency-detector' ) ) { %>
    <audio id="bg-music" loop>
      <source src="/audio/background.mp3" type="audio/mpeg">
    </audio>
    <script>
      document.addEventListener('DOMContentLoaded', function () {
        var audio = document.getElementById('bg-music');
        if (audio) {
          audio.volume = 0.5; // Set default volume to 50%

          var playAttempt = setInterval(() => {
            audio.play()
              .then(() => {
                clearInterval(playAttempt);
              })
              .catch(error => {
                console.log('Audio autoplay prevented, waiting for interaction.');
              });
          }, 3000);

          const unlockAudio = () => {
            audio.play().then(() => {
              clearInterval(playAttempt);
              document.removeEventListener('click', unlockAudio);
              document.removeEventListener('scroll', unlockAudio);
              document.removeEventListener('keydown', unlockAudio);
            }).catch(e => { });
          };

          document.addEventListener('click', unlockAudio);
          document.addEventListener('scroll', unlockAudio);
          document.addEventListener('keydown', unlockAudio);
        }
      });
    </script>
    <% } %>
</body>

