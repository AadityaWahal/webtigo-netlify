  <script>
    // Fast Reveal Animation (Hardware Accelerated)
    document.addEventListener("DOMContentLoaded", function () {
      document.body.classList.add('js-enabled');

      // Mobile drawer toggle
      const mobileMenuToggle = document.getElementById('mobile-menu-toggle');
      const mobileDrawer = document.getElementById('mobile-drawer');
      if (mobileMenuToggle && mobileDrawer) {
        mobileMenuToggle.addEventListener('click', function (e) {
          e.stopPropagation();
          mobileDrawer.classList.toggle('open');
        });
        document.addEventListener('click', function (e) {
          if (!mobileDrawer.contains(e.target) && e.target !== mobileMenuToggle) {
            mobileDrawer.classList.remove('open');
          }
        });
        mobileDrawer.querySelectorAll('a').forEach(function (link) {
          link.addEventListener('click', function () {
            mobileDrawer.classList.remove('open');
          });
        });
      }

      if (!('IntersectionObserver' in window)) {
        document.querySelectorAll('.tool-card').forEach(card => card.classList.add('reveal'));
      } else {
        const observerIn = new IntersectionObserver((entries) => {
          entries.forEach(entry => {
            if (entry.isIntersecting) {
              entry.target.classList.add('reveal');
              observerIn.unobserve(entry.target);
            }
          });
        }, { threshold: 0.05, rootMargin: "100px" });

        document.querySelectorAll('.tool-card').forEach((card, index) => {
          card.style.transitionDelay = `${Math.min(index * 30, 200)}ms`;
          observerIn.observe(card);
        });
      }

      // User Profile Dropdown Toggle
      const userMenuBtn = document.getElementById('user-menu-btn');
      const userMenuDropdown = document.getElementById('user-menu-dropdown');
      if (userMenuBtn && userMenuDropdown) {
        userMenuBtn.addEventListener('click', (e) => {
          e.stopPropagation();
          const isVisible = userMenuDropdown.style.display === 'block';
          userMenuDropdown.style.display = isVisible ? 'none' : 'block';
        });
        document.addEventListener('click', () => {
          userMenuDropdown.style.display = 'none';
        });
      }

      // Initialize Clerk UI (if Clerk keys are provided)
      <% if (typeof clerkPublishableKey !== 'undefined' && clerkPublishableKey) { %>
      const initClerk = async () => {
        if (window.Clerk) {
          try {
            await window.Clerk.load();
            const userButtonEl = document.getElementById('user-button');
            const signInBtnEl = document.getElementById('sign-in-btn');

            if (window.Clerk.user) {
              if (userButtonEl) window.Clerk.mountUserButton(userButtonEl);
              if (signInBtnEl) signInBtnEl.style.display = 'none';
            } else {
              if (signInBtnEl) signInBtnEl.style.display = 'inline-flex';
            }
          } catch (error) {
            console.error('Error loading Clerk:', error);
          }
        }
      };

      if (window.Clerk) {
        initClerk();
      } else {
        const checkClerkInterval = setInterval(() => {
          if (window.Clerk) {
            clearInterval(checkClerkInterval);
            initClerk();
          }
        }, 100);
      }
      <% } %>
    });

    // Global Logout Handler (works with both built-in session and Clerk)
    window.handleLogout = async function() {
      try {
        if (window.Clerk && window.Clerk.signOut) {
          await window.Clerk.signOut();
        }
        await fetch('/api/auth/logout', { method: 'POST' });
      } catch (e) {
        console.error('Logout error:', e);
      }
      window.location.href = '/';
    };
  </script>

  <!-- Audio Section: UI Hover & Click Sounds and Background Music (zero page-load penalty) -->
  <audio id="hover-sound" preload="none">
    <source src="/audio/hover.mp3" type="audio/mpeg">
  </audio>
  <audio id="click-sound" preload="none">
    <source src="/audio/click.mp3" type="audio/mpeg">
  </audio>

  <script>
    (function () {
      // Audio Section: Cursor Hover and Option Click Sound Effects (Lazy Loaded)
      const HOVER_AUDIO_SRC = '/audio/hover.mp3';
      const CLICK_AUDIO_SRC = '/audio/click.mp3';

      let audioCtx = null;
      let hoverAudioBuffer = null;
      let clickAudioBuffer = null;
      let lastHoverPlayTime = 0;
      let lastClickPlayTime = 0;
      const MIN_HOVER_INTERVAL_MS = 60; // Debounce rapid pointer movement
      const MIN_CLICK_INTERVAL_MS = 70; // Debounce double-trigger / label-input bubbling

      // HTML5 Audio Pools for immediate zero-config playback fallback
      const POOL_SIZE = 3;
      const hoverPool = [];
      const clickPool = [];
      let poolsInitialized = false;

      function ensureAudioPools() {
        if (poolsInitialized) return;
        poolsInitialized = true;
        for (let i = 0; i < POOL_SIZE; i++) {
          const hSound = new Audio(HOVER_AUDIO_SRC);
          hSound.volume = 0.35;
          hSound.preload = 'none';
          hoverPool.push(hSound);

          const cSound = new Audio(CLICK_AUDIO_SRC);
          cSound.volume = 0.4;
          cSound.preload = 'none';
          clickPool.push(cSound);
        }
      }
      let hoverPoolIndex = 0;
      let clickPoolIndex = 0;

      // Web Audio API buffer initialization for zero-latency multi-instance playback
      function initWebAudio() {
        try {
          const AudioContextClass = window.AudioContext || window.webkitAudioContext;
          if (!AudioContextClass) return;
          if (!audioCtx) {
            audioCtx = new AudioContextClass();
          }

          if (!hoverAudioBuffer) {
            fetch(HOVER_AUDIO_SRC)
              .then(function (res) { return res.arrayBuffer(); })
              .then(function (buffer) { return audioCtx.decodeAudioData(buffer); })
              .then(function (decoded) { hoverAudioBuffer = decoded; })
              .catch(function () {});
          }

          if (!clickAudioBuffer) {
            fetch(CLICK_AUDIO_SRC)
              .then(function (res) { return res.arrayBuffer(); })
              .then(function (buffer) { return audioCtx.decodeAudioData(buffer); })
              .then(function (decoded) { clickAudioBuffer = decoded; })
              .catch(function () {});
          }
        } catch (e) {}
      }

      // Resume suspended AudioContext upon user gesture
      function unlockAudio() {
        if (audioCtx && audioCtx.state === 'suspended') {
          audioCtx.resume().catch(function () {});
        }
      }
      ['pointerdown', 'keydown', 'click'].forEach(function (evt) {
        window.addEventListener(evt, unlockAudio, { passive: true, once: false });
      });

      if (typeof requestIdleCallback === 'function') {
        requestIdleCallback(initWebAudio);
      } else {
        setTimeout(initWebAudio, 400);
      }

      function playHoverSound() {
        const now = Date.now();
        if (now - lastHoverPlayTime < MIN_HOVER_INTERVAL_MS) return;
        lastHoverPlayTime = now;

        // 1. Try Web Audio API if buffer is ready
        if (audioCtx && hoverAudioBuffer) {
          if (audioCtx.state === 'suspended') {
            audioCtx.resume().catch(function () {});
          }
          if (audioCtx.state === 'running') {
            try {
              const source = audioCtx.createBufferSource();
              source.buffer = hoverAudioBuffer;
              const gainNode = audioCtx.createGain();
              gainNode.gain.value = 0.35;
              source.connect(gainNode);
              gainNode.connect(audioCtx.destination);
              source.start(0);
              return;
            } catch (err) {}
          }
        }

        // 2. HTML5 Audio Pool fallback
        try {
          ensureAudioPools();
          const sound = hoverPool[hoverPoolIndex];
          hoverPoolIndex = (hoverPoolIndex + 1) % POOL_SIZE;
          sound.currentTime = 0;
          const promise = sound.play();
          if (promise !== undefined) {
            promise.catch(function () {});
          }
        } catch (err) {}
      }

      function playClickSound() {
        const now = Date.now();
        if (now - lastClickPlayTime < MIN_CLICK_INTERVAL_MS) return;
        lastClickPlayTime = now;

        // 1. Try Web Audio API if buffer is ready
        if (audioCtx && clickAudioBuffer) {
          if (audioCtx.state === 'suspended') {
            audioCtx.resume().catch(function () {});
          }
          if (audioCtx.state === 'running') {
            try {
              const source = audioCtx.createBufferSource();
              source.buffer = clickAudioBuffer;
              const gainNode = audioCtx.createGain();
              gainNode.gain.value = 0.4;
              source.connect(gainNode);
              gainNode.connect(audioCtx.destination);
              source.start(0);
              return;
            } catch (err) {}
          }
        }

        // 2. HTML5 Audio Pool fallback
        try {
          ensureAudioPools();
          const sound = clickPool[clickPoolIndex];
          clickPoolIndex = (clickPoolIndex + 1) % POOL_SIZE;
          sound.currentTime = 0;
          const promise = sound.play();
          if (promise !== undefined) {
            promise.catch(function () {});
          }
        } catch (err) {}
      }

      // Selectors matching any button and service cards / service card options for HOVER
      const HOVER_SELECTORS = [
        'button',
        '.primary-btn',
        '.secondary-btn',
        '.btn',
        '.dropdown-btn',
        '.mobile-toggle-btn',
        '.sign-in-nav-btn',
        '.quick-demo-btn',
        '.mode-btn',
        '.tab-btn',
        '[role="button"]',
        'input[type="button"]',
        'input[type="submit"]',
        'input[type="reset"]',
        '.tool-card',
        '.tool-link',
        '.blog-link-inline',
        '.polyhedra-launch-link',
        '.dropdown-content a',
        '.dropdown-group a',
        '.nav-links a',
        '.mobile-drawer a',
        '.mobile-menu-drawer a',
        '.endlessync-nav-link',
        '.endlessync-launch-link',
        '.endlessync-guide-link',
        '#footer-music-toggle-btn',
        '.blog-card',
        '.video-card'
      ].join(', ');

      let currentActiveTarget = null;
      const hoverEvent = window.PointerEvent ? 'pointerover' : 'mouseover';

      document.addEventListener(hoverEvent, function (e) {
        // Only trigger on cursor hover, not touchscreen taps
        if (e.pointerType === 'touch') return;
        if (!e.target || typeof e.target.closest !== 'function') return;

        const target = e.target.closest(HOVER_SELECTORS);
        if (!target) {
          currentActiveTarget = null;
          return;
        }

        // Avoid re-triggering while navigating inside the same interactive target
        if (target === currentActiveTarget) return;

        // Avoid re-triggering when moving from a child element back to its parent container
        if (e.relatedTarget && target.contains(e.relatedTarget)) return;

        currentActiveTarget = target;
        playHoverSound();
      }, { passive: true });

      document.addEventListener('mouseleave', function () {
        currentActiveTarget = null;
      });

      // Selectors matching options that perform an action/work when clicked
      const OPTION_CLICK_SELECTORS = [
        'button',
        '.primary-btn',
        '.secondary-btn',
        '.btn',
        '.dropdown-btn',
        '.mobile-toggle-btn',
        '.sign-in-nav-btn',
        '.quick-demo-btn',
        '.mode-btn',
        '.tab-btn',
        '[role="button"]',
        'input[type="button"]',
        'input[type="submit"]',
        'input[type="reset"]',
        'input[type="checkbox"]',
        'input[type="radio"]',
        'label',
        'select',
        'option',
        'summary',
        '[role="tab"]',
        '[role="menuitem"]',
        '[role="menuitemcheckbox"]',
        '[role="menuitemradio"]',
        '[role="option"]',
        '[role="switch"]',
        'a[href]',
        '.tool-card',
        '.tool-link',
        '.blog-link-inline',
        '.polyhedra-launch-link',
        '.endlessync-launch-link',
        '.endlessync-guide-link',
        '.endlessync-nav-link',
        '.dropdown-content a',
        '.dropdown-group a',
        '.nav-links a',
        '.mobile-drawer a',
        '.mobile-menu-drawer a',
        '#footer-music-toggle-btn',
        '.blog-card',
        '.video-card',
        '[onclick]',
        '[data-action]'
      ].join(', ');

      // Determine if a click is on an active option that performs work (not random background or dead space)
      function isWorkOption(el) {
        if (!el || typeof el.closest !== 'function') return false;

        // Exclude text typing inputs & textareas (clicking to position cursor/focus is not clicking an option)
        if (el.closest('input:not([type="button"]):not([type="submit"]):not([type="reset"]):not([type="checkbox"]):not([type="radio"]):not([type="file"]), textarea, [contenteditable="true"]')) {
          return false;
        }

        const option = el.closest(OPTION_CLICK_SELECTORS);
        if (!option) return false;

        // Ignore disabled elements or disabled fieldset descendants
        if (option.matches(':disabled, [disabled], [aria-disabled="true"], .disabled') ||
            option.closest(':disabled, [disabled], [aria-disabled="true"], .disabled')) {
          return false;
        }

        // If label, verify it is associated with an input or contains an option
        if (option.tagName === 'LABEL') {
          const hasTargetInput = option.htmlFor || option.querySelector('input, select');
          if (!hasTargetInput) return false;
        }

        // If anchor with href="#" and no onclick/action class, ignore empty placeholder anchors
        if (option.tagName === 'A') {
          const href = option.getAttribute('href');
          const hasAction = option.getAttribute('onclick') ||
            option.getAttribute('role') === 'button' ||
            option.classList.contains('primary-btn') ||
            option.classList.contains('secondary-btn') ||
            option.classList.contains('btn') ||
            option.classList.contains('dropdown-btn');
          if ((!href || href === '#' || href.startsWith('javascript:void(0)')) && !hasAction) {
            return false;
          }
        }

        return true;
      }

      // Listen in capture phase so click audio plays immediately even if event propagation is stopped by child components
      document.addEventListener('click', function (e) {
        if (!e.target) return;
        if (isWorkOption(e.target)) {
          playClickSound();
        }
      }, true);

      // Also support change events on <select> dropdown options
      document.addEventListener('change', function (e) {
        if (e.target && (e.target.tagName === 'SELECT' || e.target.type === 'radio' || e.target.type === 'checkbox')) {
          playClickSound();
        }
      }, true);
    })();
  </script>

  <!-- Background Music Section: Controlled exclusively via Footer Option (NO auto-play on visit or click) -->
  <audio id="bg-music" loop preload="none">
    <source src="/audio/background.mp3" type="audio/mpeg">
  </audio>
  <script>
    (function () {
      var audio = document.getElementById('bg-music');
      var toggleBtn = document.getElementById('footer-music-toggle-btn');
      var statusText = document.getElementById('footer-music-status');
      var iconWrap = document.getElementById('footer-music-icon-wrap');
      var btnLabel = document.getElementById('footer-music-btn-label');
      var btnIcon = document.getElementById('footer-music-btn-icon');

      if (!audio || !toggleBtn) return;
      audio.volume = 0.35;

      function updateUI(isPlaying) {
        if (isPlaying) {
          if (statusText) statusText.textContent = 'Now Playing ♪';
          if (btnLabel) btnLabel.textContent = 'Pause';
          if (iconWrap) {
            iconWrap.style.background = 'rgba(16, 185, 129, 0.2)';
            iconWrap.style.borderColor = 'rgba(16, 185, 129, 0.4)';
            iconWrap.style.color = '#34d399';
            iconWrap.classList.add('music-playing-pulse');
          }
          if (btnIcon) {
            btnIcon.innerHTML = '<rect x="6" y="4" width="4" height="16"></rect><rect x="14" y="4" width="4" height="16"></rect>';
          }
          toggleBtn.style.background = 'linear-gradient(135deg, #10b981, #059669)';
        } else {
          if (statusText) statusText.textContent = 'Off • Click to play';
          if (btnLabel) btnLabel.textContent = 'Play';
          if (iconWrap) {
            iconWrap.style.background = 'rgba(59, 130, 246, 0.15)';
            iconWrap.style.borderColor = 'rgba(59, 130, 246, 0.3)';
            iconWrap.style.color = '#60a5fa';
            iconWrap.classList.remove('music-playing-pulse');
          }
          if (btnIcon) {
            btnIcon.innerHTML = '<polygon points="5 3 19 12 5 21 5 3"></polygon>';
          }
          toggleBtn.style.background = 'linear-gradient(135deg, #3b82f6, #6366f1)';
        }
      }

      toggleBtn.addEventListener('click', function () {
        if (audio.paused) {
          audio.play().then(function () {
            updateUI(true);
          }).catch(function (err) {
            console.warn('Background sound playback was prevented by browser:', err);
          });
        } else {
          audio.pause();
          updateUI(false);
        }
      });

      audio.addEventListener('play', function () {
        updateUI(true);
      });

      audio.addEventListener('pause', function () {
        updateUI(false);
      });
    })();
  </script>
