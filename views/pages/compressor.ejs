<script>
    let activeFile = null;
    let originalImageEl = null;
    let originalWidth = 0;
    let originalHeight = 0;

    const dropZone = document.getElementById('comp-drop-zone');
    const fileInput = document.getElementById('comp-file');
    const sizeInput = document.getElementById('comp-size');
    const formatSelect = document.getElementById('comp-format');
    const compressBtn = document.getElementById('compress-btn');
    const progressArea = document.getElementById('progress-area');
    const progressBarFill = document.getElementById('progress-bar-fill');
    const progressStatus = document.getElementById('progress-status');
    const progressPercent = document.getElementById('progress-percent');
    const resultDiv = document.getElementById('result');

    // Drag & Drop Listeners
    dropZone.addEventListener('click', () => fileInput.click());
    dropZone.addEventListener('dragover', (e) => {
        e.preventDefault();
        dropZone.classList.add('dragover');
    });
    dropZone.addEventListener('dragleave', () => dropZone.classList.remove('dragover'));
    dropZone.addEventListener('drop', (e) => {
        e.preventDefault();
        dropZone.classList.remove('dragover');
        if (e.dataTransfer.files && e.dataTransfer.files.length > 0) {
            handleSelectedFile(e.dataTransfer.files[0]);
        }
    });

    fileInput.addEventListener('change', (e) => {
        if (e.target.files && e.target.files.length > 0) {
            handleSelectedFile(e.target.files[0]);
        }
    });

    function setTargetSize(kb) {
        sizeInput.value = kb;
        document.querySelectorAll('.preset-pill').forEach(p => p.classList.remove('active'));
        if (event && event.target) event.target.classList.add('active');
    }

    function setRelativeTarget(ratio) {
        if (activeFile) {
            const kb = Math.max(10, Math.round((activeFile.size / 1024) * ratio));
            sizeInput.value = kb;
        } else {
            sizeInput.value = 100;
        }
        document.querySelectorAll('.preset-pill').forEach(p => p.classList.remove('active'));
        if (event && event.target) event.target.classList.add('active');
    }

    function formatBytes(bytes) {
        if (!bytes || bytes === 0) return '0 B';
        const k = 1024;
        const sizes = ['B', 'KB', 'MB', 'GB'];
        const i = Math.floor(Math.log(bytes) / Math.log(k));
        return (bytes / Math.pow(k, i)).toFixed(1) + ' ' + sizes[i];
    }

    function resetFilePicker() {
        activeFile = null;
        originalImageEl = null;
        fileInput.value = '';
        document.getElementById('file-info-card').style.display = 'none';
        dropZone.style.display = 'block';
        resultDiv.style.display = 'none';
        progressArea.style.display = 'none';
    }

    function handleSelectedFile(file) {
        if (!file.type.startsWith('image/') && !file.name.match(/\.(png|jpe?g|webp|bmp|gif|svg|avif|heic)$/i)) {
            alert('Please select a valid image file (PNG, JPG, WebP, etc.).');
            return;
        }

        activeFile = file;
        resultDiv.style.display = 'none';
        progressArea.style.display = 'none';

        // Load image into memory to get dimensions & thumbnail
        const reader = new FileReader();
        reader.onload = (e) => {
            const img = new Image();
            img.onload = () => {
                originalImageEl = img;
                originalWidth = img.naturalWidth || img.width;
                originalHeight = img.naturalHeight || img.height;

                document.getElementById('file-thumbnail').src = e.target.result;
                document.getElementById('file-name-label').textContent = file.name;
                document.getElementById('file-size-label').textContent = formatBytes(file.size);
                document.getElementById('file-dims-label').textContent = `${originalWidth} × ${originalHeight} px`;

                // Set intelligent default target size (e.g. 100KB or 40% of original)
                const originalKB = Math.round(file.size / 1024);
                if (originalKB > 200) {
                    sizeInput.value = Math.max(50, Math.min(300, Math.round(originalKB * 0.35)));
                } else {
                    sizeInput.value = Math.max(20, Math.round(originalKB * 0.6));
                }

                document.getElementById('file-info-card').style.display = 'flex';
                dropZone.style.display = 'none';
            };
            img.onerror = () => {
                // If browser failed to decode, still allow server-side fallback
                document.getElementById('file-name-label').textContent = file.name;
                document.getElementById('file-size-label').textContent = formatBytes(file.size);
                document.getElementById('file-dims-label').textContent = 'Ready to compress';
                document.getElementById('file-info-card').style.display = 'flex';
                dropZone.style.display = 'none';
            };
            img.src = e.target.result;
        };
        reader.readAsDataURL(file);
    }

    function updateProgress(percent, msg) {
        progressArea.style.display = 'block';
        progressBarFill.style.width = percent + '%';
        progressPercent.textContent = percent + '%';
        if (msg) progressStatus.textContent = msg;
    }

    /**
     * Primary: High-speed In-Browser Canvas Multi-pass Compression
     * Works on any size file up to 50MB+ with zero server limits.
     */
    async function compressInBrowser(file, targetSizeKB, requestedFormat) {
        return new Promise(async (resolve, reject) => {
            try {
                let img = originalImageEl;
                if (!img) {
                    img = await new Promise((resImg, rejImg) => {
                        const i = new Image();
                        i.onload = () => resImg(i);
                        i.onerror = rejImg;
                        i.src = URL.createObjectURL(file);
                    });
                }

                const srcWidth = img.naturalWidth || img.width;
                const srcHeight = img.naturalHeight || img.height;
                if (!srcWidth || !srcHeight) throw new Error('Could not calculate image dimensions.');

                // Determine target MIME type
                let outMime = 'image/jpeg';
                let ext = 'jpg';
                const isPngInput = file.type === 'image/png' || file.name.match(/\.png$/i);

                if (requestedFormat === 'png') {
                    outMime = 'image/png';
                    ext = 'png';
                } else if (requestedFormat === 'webp') {
                    outMime = 'image/webp';
                    ext = 'webp';
                } else if (requestedFormat === 'auto') {
                    // For photos, JPEG provides best ratio. For PNGs with transparency, WebP or PNG.
                    outMime = isPngInput ? 'image/png' : 'image/jpeg';
                    ext = isPngInput ? 'png' : 'jpg';
                } else {
                    outMime = 'image/jpeg';
                    ext = 'jpg';
                }

                const targetBytes = targetSizeKB * 1024;
                let quality = 0.90;
                let scale = 1.0;
                let bestBlob = null;

                const canvas = document.createElement('canvas');
                const ctx = canvas.getContext('2d');

                // Render function for a given scale & quality
                async function renderBlob(currScale, currQuality) {
                    const w = Math.max(10, Math.round(srcWidth * currScale));
                    const h = Math.max(10, Math.round(srcHeight * currScale));
                    canvas.width = w;
                    canvas.height = h;

                    // If converting to JPEG, fill background with white so transparent PNGs don't become black
                    if (outMime === 'image/jpeg') {
                        ctx.fillStyle = '#ffffff';
                        ctx.fillRect(0, 0, w, h);
                    } else {
                        ctx.clearRect(0, 0, w, h);
                    }

                    ctx.imageSmoothingEnabled = true;
                    ctx.imageSmoothingQuality = 'high';
                    ctx.drawImage(img, 0, 0, w, h);

                    return new Promise((blobRes) => {
                        canvas.toBlob((b) => blobRes(b), outMime, currQuality);
                    });
                }

                updateProgress(35, 'Encoding initial compression pass...');
                bestBlob = await renderBlob(scale, quality);

                // If PNG lossless is still too large, suggest/auto-switch to WebP or scale dimensions
                if (outMime === 'image/png' && bestBlob.size > targetBytes) {
                    // If target size is strict, adaptively downscale dimensions to hit target
                    let attempts = 0;
                    while (bestBlob.size > targetBytes && attempts < 5 && scale > 0.3) {
                        attempts++;
                        scale *= 0.85;
                        updateProgress(35 + attempts * 10, 'Scaling resolution to achieve target KB...');
                        bestBlob = await renderBlob(scale, quality);
                    }
                } else {
                    // Lossy binary/stepped search for JPEG/WebP
                    let lowQ = 0.15;
                    let highQ = 0.92;
                    let iterations = 0;

                    while (iterations < 6) {
                        iterations++;
                        updateProgress(30 + iterations * 10, `Optimizing quality pass ${iterations}...`);
                        if (bestBlob.size > targetBytes) {
                            highQ = quality;
                            quality = (lowQ + highQ) / 2;
                        } else if (bestBlob.size < targetBytes * 0.75 && quality < 0.90) {
                            lowQ = quality;
                            quality = (lowQ + highQ) / 2;
                        } else {
                            break;
                        }

                        // If quality reached lower bounds and file is still over target, downscale dimensions
                        if (quality <= 0.22 && bestBlob.size > targetBytes && scale > 0.35) {
                            scale *= 0.82;
                            quality = 0.70;
                            lowQ = 0.20;
                            highQ = 0.85;
                        }

                        const nextBlob = await renderBlob(scale, quality);
                        if (nextBlob) {
                            bestBlob = nextBlob;
                        }
                    }
                }

                updateProgress(90, 'Finalizing compressed image...');
                resolve({ blob: bestBlob, ext: ext, mimeType: outMime });
            } catch (err) {
                reject(err);
            }
        });
    }

    /**
     * Fallback: Server-side Sharp API Route
     */
    async function compressOnServer(file, targetSizeKB, requestedFormat) {
        updateProgress(50, 'Using server-assisted compression...');
        const formData = new FormData();
        formData.append('image', file);
        formData.append('size_kb', targetSizeKB);
        formData.append('format', requestedFormat);

        const res = await fetch('/api/compress-image', { method: 'POST', body: formData });
        if (!res.ok) {
            const errText = await res.text();
            throw new Error(errText || 'Server compression failed');
        }

        const blob = await res.blob();
        const contentType = res.headers.get('content-type') || 'image/jpeg';
        let ext = 'jpg';
        if (contentType.includes('png')) ext = 'png';
        if (contentType.includes('webp')) ext = 'webp';

        return { blob, ext, mimeType: contentType };
    }

    async function startCompression() {
        if (!activeFile) {
            alert('Please select or drop an image first.');
            return;
        }

        const targetKB = parseInt(sizeInput.value, 10);
        if (isNaN(targetKB) || targetKB < 5) {
            alert('Please enter a valid target size (minimum 5 KB).');
            return;
        }

        const format = formatSelect.value;
        const originalBtnText = compressBtn.innerHTML;

        compressBtn.disabled = true;
        compressBtn.innerHTML = '<span>⏳ Compressing...</span>';
        resultDiv.style.display = 'none';
        updateProgress(15, 'Initializing compression engine...');

        try {
            let compressionResult = null;

            // Step 1: Try in-browser client-side compression (Zero latency, no 10MB limit)
            try {
                compressionResult = await compressInBrowser(activeFile, targetKB, format);
            } catch (clientErr) {
                console.warn('Client-side compression fell back to server route:', clientErr);
                compressionResult = await compressOnServer(activeFile, targetKB, format);
            }

            updateProgress(100, 'Complete!');
            setTimeout(() => { progressArea.style.display = 'none'; }, 500);

            const blob = compressionResult.blob;
            const ext = compressionResult.ext;
            const mimeType = compressionResult.mimeType;

            const baseName = activeFile.name.replace(/\.[^/.]+$/, "");
            const filename = `webtigo-compressed-${baseName}.${ext}`;

            // Populate Results
            document.getElementById('res-orig-size').textContent = formatBytes(activeFile.size);
            document.getElementById('res-new-size').textContent = formatBytes(blob.size);

            const savedPercent = Math.max(0, Math.round(((activeFile.size - blob.size) / activeFile.size) * 100));
            document.getElementById('res-reduction').textContent = `-${savedPercent}%`;

            const previewUrl = URL.createObjectURL(blob);
            document.getElementById('res-preview-img').src = previewUrl;

            // Direct local download anchor
            const downloadBtn = document.getElementById('res-direct-download');
            downloadBtn.href = previewUrl;
            downloadBtn.download = filename;

            // Render Webtigo Share Hub (Drive, Email, WhatsApp, Instagram)
            if (window.WebtigoShare) {
                window.WebtigoShare.renderHub('#comp-share-hub', {
                    blob: blob,
                    filename: filename,
                    title: 'Compressed Image - Webtigo',
                    text: `Compressed image using Webtigo Best Image Compressor: ${filename} (Saved ${savedPercent}%)`,
                    mimeType: mimeType,
                    subject: 'Compressed Image from Webtigo'
                });
            }

            resultDiv.style.display = 'block';
            resultDiv.scrollIntoView({ behavior: 'smooth', block: 'nearest' });

        } catch (err) {
            console.error('Compression failure:', err);
            alert('Image compression failed: ' + err.message);
            progressArea.style.display = 'none';
        } finally {
            compressBtn.disabled = false;
            compressBtn.innerHTML = originalBtnText;
        }
    }
</script>

