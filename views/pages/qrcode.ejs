<script>
    async function generateQR() {
        const text = document.getElementById('qr-text').value;
        const resultDiv = document.getElementById('result');

        if (!text) return alert('Enter text or URL');

        const formData = new FormData();
        formData.append('data', text);

        try {
            const res = await fetch('/api/generate-qr', { method: 'POST', body: formData });
            if (!res.ok) throw new Error('Failed to generate QR code');

            const blob = await res.blob();
            const url = URL.createObjectURL(blob);

            const img = document.getElementById('qr-img');
            img.src = url;

            const filename = `webtigo-qrcode-${Date.now()}.png`;

            if (window.WebtigoShare) {
                window.WebtigoShare.renderHub('#qr-share-hub', {
                    blob: blob,
                    filename: filename,
                    title: 'Webtigo QR Code',
                    text: `Scan or view this QR code created with Webtigo: ${text}`,
                    mimeType: 'image/png',
                    subject: 'My Webtigo QR Code'
                });
            }

            resultDiv.style.display = 'block';
        } catch (e) {
            alert(e.message);
        }
    }

    window.addEventListener('DOMContentLoaded', () => {
        const params = new URLSearchParams(window.location.search);
        if (params.has('text')) {
            document.getElementById('qr-text').value = decodeURIComponent(params.get('text'));
        }
        if (params.get('auto') === 'true' && params.has('text')) {
            setTimeout(generateQR, 300);
        }
    });

</script>

