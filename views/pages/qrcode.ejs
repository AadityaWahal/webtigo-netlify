        <img id="qr-img" src="" alt="QR Code" style="max-width: 100%; border-radius: 8px; margin-bottom: 0.5rem; background: white; padding: 12px; box-shadow: 0 4px 20px rgba(0,0,0,0.3);">
        <div id="qr-share-hub"></div>
    </div>
