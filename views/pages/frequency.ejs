<div class="glass-card" style="max-width: 600px; margin: 0 auto;">
    <h1 style="margin-bottom: 2rem; text-align: center;">Frequency Generator</h1>
    <p style="text-align: center; color: rgba(255, 255, 255, 0.7); margin-bottom: 2rem; font-size: 1.05rem;">
        Generate pure tone frequencies from 20Hz to 20,000Hz online for <strong>free</strong>. Test your speakers,
        headphones, or hearing.<br><br>
        Need to detect a frequency instead? Try the <a href="/frequency-detector"
            style="color: var(--primary); text-decoration: underline;">Frequency Detector</a>.
    </p>

    <div class="form-group">
        <label>Frequency (Hz)</label>
        <input type="number" id="freq-val" value="440" min="1" max="24000" oninput="updateFreq(this.value)">
        <input type="range" id="freq-slider" min="1" max="24000" value="440" oninput="updateFreq(this.value)"
            style="width: 100%; margin-top: 1rem;">
    </div>

    <div class="form-group">
        <label>Wave Type</label>
        <select id="wave-type" onchange="updateType(this.value)">
            <option value="sine">Sine</option>
            <option value="square">Square</option>
            <option value="sawtooth">Sawtooth</option>
            <option value="triangle">Triangle</option>
        </select>
    </div>

    <button id="toggle-btn" class="primary-btn" onclick="toggleOscillator()">Start</button>
</div>

<script>
    let audioCtx;
    let oscillator;
    let isPlaying = false;

    function initAudio() {
        if (!audioCtx) audioCtx = new (window.AudioContext || window.webkitAudioContext)();
    }

    function toggleOscillator() {
        initAudio();
        const btn = document.getElementById('toggle-btn');

        if (isPlaying) {
            oscillator.stop();
            oscillator.disconnect();
            isPlaying = false;
            btn.innerText = "Start";
            btn.style.background = "var(--primary)";
        } else {
            oscillator = audioCtx.createOscillator();
            oscillator.type = document.getElementById('wave-type').value;
            oscillator.frequency.value = document.getElementById('freq-val').value;
            oscillator.connect(audioCtx.destination);
            oscillator.start();
            isPlaying = true;
            btn.innerText = "Stop";
            btn.style.background = "#ef4444";
        }
    }

    function updateFreq(val) {
        document.getElementById('freq-val').value = val;
        document.getElementById('freq-slider').value = val;
        if (oscillator && isPlaying) {
            oscillator.frequency.value = val;
        }
    }

    function updateType(type) {
        if (oscillator && isPlaying) {
            oscillator.type = type;
        }
    }

    function playFreqLink(hz) {
        document.getElementById('freq-val').value = hz;
        document.getElementById('freq-slider').value = hz;
        if (oscillator && isPlaying) {
            oscillator.frequency.value = hz;
        } else {
            toggleOscillator();
        }
        window.scrollTo({ top: 0, behavior: 'smooth' });
    }

    document.addEventListener('DOMContentLoaded', () => {
        const params = new URLSearchParams(window.location.search);
        const hzParam = params.get('hz');

        if (hzParam) {
            const hz = parseInt(hzParam, 10);
            if (!isNaN(hz) && hz >= 1 && hz <= 24000) {
                // Update Inputs
                document.getElementById('freq-val').value = hz;
                document.getElementById('freq-slider').value = hz;

                // Auto Start
                setTimeout(() => {
                    toggleOscillator();
                }, 500); // Slight delay for UI to settle
            }
        }
    });
</script>

<div class="glass-card" style="max-width: 800px; margin: 3rem auto; padding: 2.5rem; position: relative; text-align: left;">
    <h2 style="color: var(--primary); margin-bottom: 1.5rem; border-bottom: 1px solid rgba(255,255,255,0.1); padding-bottom: 0.75rem; text-align: center; font-size: 1.8rem;">
        Guide to Audio Frequencies & Waveforms
    </h2>
    <p style="color: rgba(255,255,255,0.85); line-height: 1.8; margin-bottom: 1.5rem;">
        Sound is an acoustic pressure wave moving through the air. The frequency (measured in Hertz, or Hz) describes the number of vibrations per second. Human hearing typically spans from <strong>20 Hz</strong> (deep rumble) to <strong>20,000 Hz (20 kHz)</strong> (high-pitched sparkle).
    </p>

    <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(240px, 1fr)); gap: 1.25rem; margin-bottom: 2rem;">
        <div style="background: rgba(255, 255, 255, 0.04); padding: 1.25rem; border-radius: 12px; border: 1px solid rgba(255, 255, 255, 0.08);">
            <h4 style="color: #60a5fa; margin-bottom: 0.5rem; font-size: 1.1rem;">Sine Wave (Pure Tone)</h4>
            <p style="color: #cbd5e1; font-size: 0.9rem; line-height: 1.5; margin: 0;">
                The fundamental building block of acoustic science. Contains only a single fundamental frequency with zero harmonic overtones. Used for hearing calibration and subwoofer tuning.
            </p>
        </div>
        <div style="background: rgba(255, 255, 255, 0.04); padding: 1.25rem; border-radius: 12px; border: 1px solid rgba(255, 255, 255, 0.08);">
            <h4 style="color: #34d399; margin-bottom: 0.5rem; font-size: 1.1rem;">Square Wave</h4>
            <p style="color: #cbd5e1; font-size: 0.9rem; line-height: 1.5; margin: 0;">
                Alternates abruptly between positive and negative amplitudes. Rich in odd harmonics, producing a buzzing, arcade-like retro timbre common in electronic music synthesizers.
            </p>
        </div>
        <div style="background: rgba(255, 255, 255, 0.04); padding: 1.25rem; border-radius: 12px; border: 1px solid rgba(255, 255, 255, 0.08);">
            <h4 style="color: #f472b6; margin-bottom: 0.5rem; font-size: 1.1rem;">Sawtooth Wave</h4>
            <p style="color: #cbd5e1; font-size: 0.9rem; line-height: 1.5; margin: 0;">
                Ramps upward sharply and drops instantly. Contains both even and odd harmonics, yielding an aggressive, bright, brass-like tone used in modern sound design.
            </p>
        </div>
        <div style="background: rgba(255, 255, 255, 0.04); padding: 1.25rem; border-radius: 12px; border: 1px solid rgba(255, 255, 255, 0.08);">
            <h4 style="color: #fbbf24; margin-bottom: 0.5rem; font-size: 1.1rem;">Triangle Wave</h4>
            <p style="color: #cbd5e1; font-size: 0.9rem; line-height: 1.5; margin: 0;">
                Contains odd harmonics like a square wave, but the higher overtones roll off far more rapidly, giving it a soft, mellow, flute-like texture.
            </p>
        </div>
    </div>

    <div style="border-top: 1px solid rgba(255,255,255,0.08); padding-top: 1.5rem;">
        <h3 style="color: white; font-size: 1.3rem; margin-bottom: 1rem;">Audio Safety & Calibration FAQs</h3>
        <div style="margin-bottom: 1.25rem;">
            <h5 style="color: var(--primary); font-size: 1rem; margin-bottom: 0.35rem;">What is the 440 Hz standard pitch?</h5>
            <p style="color: #94a3b8; font-size: 0.9rem; line-height: 1.5; margin: 0;">
                440 Hz represents the concert pitch A above middle C (A4), established in 1955 as the international standard for tuning musical instruments and concert orchestras worldwide.
            </p>
        </div>
        <div style="margin-bottom: 1.25rem;">
            <h5 style="color: var(--primary); font-size: 1rem; margin-bottom: 0.35rem;">How do I test my headphones safely?</h5>
            <p style="color: #94a3b8; font-size: 0.9rem; line-height: 1.5; margin: 0;">
                Always start at a low volume before hitting "Start". High-frequency tones above 12,000 Hz or high volumes can cause speaker distortion or ear fatigue. Gradually increase volume to test frequency response.
            </p>
        </div>
    </div>

    <div style="text-align: center; margin-top: 2rem;">
        <a href="/blog/frequency-generator" class="secondary-btn" style="background: transparent; color: var(--primary); border: 1px solid var(--primary); text-decoration: none; display: inline-block; padding: 0.75rem 1.5rem;">
            Read Full Sound Frequency Guide on our Blog &rarr;
        </a>
    </div>
</div>