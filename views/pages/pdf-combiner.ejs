<!-- PDF-Lib Library for High-Speed Client-Side Merging -->
<script src="https://cdnjs.cloudflare.com/ajax/libs/pdf-lib/1.17.1/pdf-lib.min.js"></script>

<script>
    let pdfFiles = [];
    const dropZone = document.getElementById('drop-zone');
    const fileInput = document.getElementById('file-input');
    const fileListContainer = document.getElementById('file-list-container');
    const fileList = document.getElementById('file-list');
    const fileCountBadge = document.getElementById('file-count-badge');
    const totalPagesStat = document.getElementById('total-pages-stat');
    const totalSizeStat = document.getElementById('total-size-stat');
    const combineBtn = document.getElementById('combine-btn');
    const statusContainer = document.getElementById('status-container');
    const progressBar = document.getElementById('progress-bar');
    const statusText = document.getElementById('status-text');

    // Drag & Drop
    dropZone.addEventListener('click', () => fileInput.click());

    dropZone.addEventListener('dragover', (e) => {
        e.preventDefault();
        dropZone.classList.add('dragover');
    });

    dropZone.addEventListener('dragleave', () => dropZone.classList.remove('dragover'));

    dropZone.addEventListener('drop', (e) => {
        e.preventDefault();
        dropZone.classList.remove('dragover');
        handleIncomingFiles(e.dataTransfer.files);
    });

    fileInput.addEventListener('change', (e) => {
        handleIncomingFiles(e.target.files);
        fileInput.value = ''; // Reset input so same file can be re-selected if desired
    });

    function formatFileSize(bytes) {
        if (!bytes || bytes === 0) return '0 B';
        const k = 1024;
        const sizes = ['B', 'KB', 'MB', 'GB'];
        const i = Math.floor(Math.log(bytes) / Math.log(k));
        return parseFloat((bytes / Math.pow(k, i)).toFixed(1)) + ' ' + sizes[i];
    }

    async function handleIncomingFiles(files) {
        const incoming = Array.from(files).filter(f => f.type === 'application/pdf' || f.name.toLowerCase().endsWith('.pdf'));
        if (incoming.length === 0) {
            alert('Please select valid PDF files (.pdf).');
            return;
        }

        // Add to pdfFiles array with placeholder page count
        for (const file of incoming) {
            const fileItem = {
                id: 'pdf_' + Math.random().toString(36).substring(2, 9),
                file: file,
                name: file.name,
                size: file.size,
                pageCount: null
            };
            pdfFiles.push(fileItem);
        }

        renderFileList();
        inspectPageCounts();
    }

    // Inspect page count for files asynchronously
    async function inspectPageCounts() {
        if (typeof PDFLib === 'undefined') return;

        for (const item of pdfFiles) {
            if (item.pageCount === null) {
                try {
                    const arrayBuffer = await item.file.arrayBuffer();
                    const doc = await PDFLib.PDFDocument.load(arrayBuffer, { ignoreEncryption: true });
                    item.pageCount = doc.getPageCount();
                } catch (e) {
                    console.warn('Could not inspect page count for', item.name, e);
                    item.pageCount = 'Unknown';
                }
                updateFileRow(item);
                updateStats();
            }
        }
    }

    function updateFileRow(item) {
        const countSpan = document.getElementById('pages-' + item.id);
        if (countSpan) {
            countSpan.textContent = typeof item.pageCount === 'number' ? `${item.pageCount} ${item.pageCount === 1 ? 'page' : 'pages'}` : 'PDF';
        }
    }

    function renderFileList() {
        if (pdfFiles.length === 0) {
            fileListContainer.style.display = 'none';
            return;
        }

        fileListContainer.style.display = 'block';
        fileList.innerHTML = '';

        pdfFiles.forEach((item, index) => {
            const li = document.createElement('li');
            li.className = 'file-item';
            const pageText = item.pageCount !== null ? (typeof item.pageCount === 'number' ? `${item.pageCount} ${item.pageCount === 1 ? 'page' : 'pages'}` : 'PDF') : 'Detecting pages...';

            li.innerHTML = `
                <div class="file-info">
                    <div class="file-order-num">${index + 1}</div>
                    <div class="file-details">
                        <span class="file-name" title="${item.name}">${item.name}</span>
                        <div class="file-meta">
                            <span>${formatFileSize(item.size)}</span>
                            <span>&bull;</span>
                            <span class="file-page-tag" id="pages-${item.id}">${pageText}</span>
                        </div>
                    </div>
                </div>
                <div class="file-actions">
                    <button type="button" class="file-action-btn" onclick="moveFile(${index}, -1)" ${index === 0 ? 'disabled' : ''} title="Move Up">↑</button>
                    <button type="button" class="file-action-btn" onclick="moveFile(${index}, 1)" ${index === pdfFiles.length - 1 ? 'disabled' : ''} title="Move Down">↓</button>
                    <button type="button" class="file-action-btn file-remove-btn" onclick="removeFile('${item.id}')" title="Remove PDF">✕</button>
                </div>
            `;
            fileList.appendChild(li);
        });

        updateStats();
    }

    window.moveFile = (index, direction) => {
        const targetIndex = index + direction;
        if (targetIndex < 0 || targetIndex >= pdfFiles.length) return;
        const temp = pdfFiles[index];
        pdfFiles[index] = pdfFiles[targetIndex];
        pdfFiles[targetIndex] = temp;
        renderFileList();
    };

    window.removeFile = (id) => {
        pdfFiles = pdfFiles.filter(item => item.id !== id);
        renderFileList();
    };

    window.clearAllFiles = () => {
        if (confirm('Are you sure you want to remove all uploaded PDFs?')) {
            pdfFiles = [];
            renderFileList();
        }
    };

    function updateStats() {
        const total = pdfFiles.length;
        fileCountBadge.textContent = `${total} ${total === 1 ? 'file' : 'files'}`;

        let totalBytes = 0;
        let totalPages = 0;
        let allKnown = true;

        pdfFiles.forEach(item => {
            totalBytes += item.size || 0;
            if (typeof item.pageCount === 'number') {
                totalPages += item.pageCount;
            } else {
                allKnown = false;
            }
        });

        totalSizeStat.textContent = formatFileSize(totalBytes);
        if (total === 0) {
            totalPagesStat.textContent = '0 pages';
        } else if (allKnown) {
            totalPagesStat.textContent = `${totalPages} ${totalPages === 1 ? 'page' : 'pages'}`;
        } else {
            totalPagesStat.textContent = 'Calculating...';
        }

        // Enable or disable combine button (requires at least 2 PDFs)
        if (total >= 2) {
            combineBtn.disabled = false;
            combineBtn.style.opacity = '1';
            combineBtn.style.cursor = 'pointer';
            combineBtn.title = 'Click to combine selected PDFs';
        } else {
            combineBtn.disabled = true;
            combineBtn.style.opacity = '0.5';
            combineBtn.style.cursor = 'not-allowed';
            combineBtn.title = 'Add at least 2 PDF files to combine';
        }
    }

    // Combine PDFs function
    window.combinePdfs = async () => {
        if (pdfFiles.length < 2) {
            alert('Please select at least 2 PDF files to combine.');
            return;
        }

        const originalBtnText = combineBtn.innerHTML;
        combineBtn.disabled = true;
        combineBtn.innerHTML = `<span>⏳ Combining ${pdfFiles.length} PDFs...</span>`;
        statusContainer.style.display = 'block';
        progressBar.style.width = '10%';
        statusText.textContent = 'Preparing documents...';

        let customFilename = document.getElementById('output-filename').value.trim();
        if (!customFilename) customFilename = 'webtigo-combined.pdf';
        if (!customFilename.toLowerCase().endsWith('.pdf')) customFilename += '.pdf';

        try {
            // Client-Side High-Speed Merging with PDF-Lib
            const { PDFDocument } = PDFLib;
            const mergedPdf = await PDFDocument.create();

            for (let i = 0; i < pdfFiles.length; i++) {
                const item = pdfFiles[i];
                const pct = Math.round(15 + ((i + 1) / pdfFiles.length) * 70);
                progressBar.style.width = `${pct}%`;
                statusText.textContent = `Merging (${i + 1}/${pdfFiles.length}): ${item.name}...`;

                const arrayBuffer = await item.file.arrayBuffer();
                const srcPdf = await PDFDocument.load(arrayBuffer, { ignoreEncryption: true });
                const pageIndices = srcPdf.getPageIndices();
                const copiedPages = await mergedPdf.copyPages(srcPdf, pageIndices);

                for (const page of copiedPages) {
                    mergedPdf.addPage(page);
                }
            }

            statusText.textContent = 'Saving combined PDF...';
            progressBar.style.width = '92%';

            const mergedBytes = await mergedPdf.save();
            progressBar.style.width = '100%';
            statusText.textContent = 'Done! Combined PDF ready.';

            const blob = new Blob([mergedBytes], { type: 'application/pdf' });
            
            if (window.WebtigoShare) {
                window.WebtigoShare.renderHub('#combine-share-hub', {
                    blob: blob,
                    filename: customFilename,
                    title: 'Combined PDF - Webtigo',
                    text: `Combined ${pdfFiles.length} PDFs into ${customFilename} using Webtigo PDF Combiner: https://webtigo.netlify.app/pdf-combiner`,
                    mimeType: 'application/pdf',
                    subject: `Combined Document: ${customFilename}`
                });
            }

            // Trigger instant download
            const downloadUrl = URL.createObjectURL(blob);
            const a = document.createElement('a');
            a.href = downloadUrl;
            a.download = customFilename;
            document.body.appendChild(a);
            a.click();
            document.body.removeChild(a);
            setTimeout(() => URL.revokeObjectURL(downloadUrl), 5000);

            setTimeout(() => {
                statusText.textContent = `✅ Successfully merged ${pdfFiles.length} PDFs into ${customFilename}!`;
            }, 500);

        } catch (err) {
            console.error('Client-side merge error, falling back to server route:', err);
            statusText.textContent = 'Local merge encountered an issue. Using server fallback...';
            progressBar.style.width = '50%';

            // Server-assisted fallback via /api/combine-pdf
            try {
                const formData = new FormData();
                pdfFiles.forEach(item => formData.append('pdfs', item.file));

                const response = await fetch('/api/combine-pdf', {
                    method: 'POST',
                    body: formData
                });

                if (!response.ok) {
                    const errText = await response.text();
                    throw new Error(errText || 'Server merge failed');
                }

                progressBar.style.width = '100%';
                const blob = await response.blob();

                if (window.WebtigoShare) {
                    window.WebtigoShare.renderHub('#combine-share-hub', {
                        blob: blob,
                        filename: customFilename,
                        title: 'Combined PDF - Webtigo',
                        text: `Combined ${pdfFiles.length} PDFs into ${customFilename} using Webtigo: https://webtigo.netlify.app/pdf-combiner`,
                        mimeType: 'application/pdf',
                        subject: `Combined Document: ${customFilename}`
                    });
                }

                const downloadUrl = URL.createObjectURL(blob);
                const a = document.createElement('a');
                a.href = downloadUrl;
                a.download = customFilename;
                document.body.appendChild(a);
                a.click();
                document.body.removeChild(a);
                setTimeout(() => URL.revokeObjectURL(downloadUrl), 5000);
                statusText.textContent = `✅ Successfully combined ${pdfFiles.length} PDFs!`;
            } catch (fallbackErr) {
                console.error('Server fallback error:', fallbackErr);
                alert('Failed to combine PDFs: ' + fallbackErr.message);
                statusText.textContent = 'Error combining PDFs. Please check your files.';
            }
        } finally {
            combineBtn.disabled = false;
            combineBtn.innerHTML = originalBtnText;
        }
    };
</script>

